{
  "name": "bp-uv-resource-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first UniApp resource and service booking boilerplate based on HIA-uView.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "node scripts/verify-input-pins.mjs && node scripts/check-rop.mjs && node scripts/verify-runtime-i18n.mjs",
    "test": "pnpm run check && node --test test/*.test.mjs",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin && node scripts/prepare-mp-devtools-project.mjs && node scripts/verify-mp-runtime-shell.mjs"
  },
  "dependencies": {
    "@hia-uview/biz-project-runtime": "file:src/vendor/HIA-uView-Biz/packages/project-runtime",
    "@hia-uview/ui": "file:src/vendor/HIA-uView/HIA-uView-UI",
    "@dcloudio/uni-app": "3.0.0-5010520260709002",
    "@dcloudio/uni-h5": "3.0.0-5010520260709002",
    "@vue/reactivity": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "@vue/shared": "3.4.21",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/uni-components": "3.0.0-5010520260709002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
    "sass": "1.77.8",
    "vite": "5.2.8"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@hia-uview/biz-async-provider-runtime@0.0.0": "file:src/vendor/HIA-uView-Biz/packages/async-provider-runtime",
      "@hia-uview/biz-provider-port-runtime@0.0.0": "file:src/vendor/HIA-uView-Biz/packages/provider-port-runtime",
      "@hia-uview/biz-solution-profile-runtime@0.0.0": "file:src/vendor/HIA-uView-Biz/packages/solution-profile-runtime"
    }
  }
}
